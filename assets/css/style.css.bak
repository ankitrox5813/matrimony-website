@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@300;400;500;600&display=swap');

/* ── Design Tokens ────────────────────────────────────────── */
:root {
  /* Brand palette */
  --crimson-900: #4a0e22;
  --crimson-800: #6d1533;
  --crimson-700: #8b1e3f;
  --crimson-600: #a8244a;
  --crimson-500: #c42d58;
  --crimson-400: #d95678;
  --crimson-100: #fbeaf0;
  --crimson-50:  #fdf4f7;

  --gold-400: #c9954a;
  --gold-300: #ddb06e;
  --gold-100: #f7edd9;

  --ink-900: #1a1014;
  --ink-700: #3d2632;
  --ink-500: #6b4d58;
  --ink-300: #b89daa;
  --ink-100: #f0eaed;

  /* Semantic */
  --clr-primary:      var(--crimson-700);
  --clr-primary-dark: var(--crimson-800);
  --clr-accent:       var(--gold-400);
  --clr-bg:           #fdf8fa;
  --clr-surface:      #ffffff;
  --clr-text:         var(--ink-900);
  --clr-muted:        var(--ink-500);
  --clr-border:       #e4d5db;

  /* Typography */
  --font-display: 'Cormorant Garamond', Georgia, serif;
  --font-body:    'DM Sans', system-ui, sans-serif;

  /* Spacing scale */
  --sp-xs:  4px;
  --sp-sm:  8px;
  --sp-md:  16px;
  --sp-lg:  32px;
  --sp-xl:  64px;

  /* Shape */
  --radius-sm:  6px;
  --radius-md:  12px;
  --radius-lg:  20px;
  --radius-full: 9999px;

  /* Shadow */
  --shadow-sm:  0 2px 8px rgba(74,14,34,.07);
  --shadow-md:  0 6px 24px rgba(74,14,34,.10);
  --shadow-lg:  0 16px 48px rgba(74,14,34,.13);

  /* Motion */
  --ease-out: cubic-bezier(.22,.68,0,1.2);
  --dur-fast: 180ms;
  --dur-med:  320ms;
}

/* ── Reset ────────────────────────────────────────────────── */
*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }

html { scroll-behavior: smooth; font-size: 16px; }

body {
  font-family: var(--font-body);
  background: var(--clr-bg);
  color: var(--clr-text);
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

img { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
button, input, select, textarea { font-family: inherit; }

/* ── Typography helpers ───────────────────────────────────── */
.display-heading {
  font-family: var(--font-display);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -.01em;
}

.section-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 600;
  color: var(--clr-primary-dark);
  text-align: center;
  margin-bottom: var(--sp-lg);
  position: relative;
}

.section-title::after {
  content: '';
  display: block;
  width: 48px;
  height: 3px;
  background: linear-gradient(90deg, var(--clr-primary), var(--clr-accent));
  border-radius: var(--radius-full);
  margin: 10px auto 0;
}

/* ── Navbar ───────────────────────────────────────────────── */
header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(253,248,250,.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--clr-border);
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--sp-lg);
  height: 68px;
}

.logo {
  font-family: var(--font-display);
  font-size: 1.85rem;
  font-weight: 700;
  color: var(--clr-primary-dark);
  letter-spacing: .02em;
  position: relative;
}

.logo::after {
  content: '';
  position: absolute;
  left: 0; bottom: 1px;
  width: 100%; height: 2px;
  background: linear-gradient(90deg, var(--clr-accent), transparent);
  border-radius: var(--radius-full);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 4px;
  list-style: none;
}

.nav-links a {
  font-size: .9rem;
  font-weight: 500;
  color: var(--clr-muted);
  padding: 6px 14px;
  border-radius: var(--radius-full);
  transition: color var(--dur-fast), background var(--dur-fast);
}

.nav-links a:hover {
  color: var(--clr-primary);
  background: var(--crimson-50);
}

.nav-links li:last-child a {
  color: var(--clr-surface);
  background: var(--clr-primary);
  padding: 7px 20px;
}

.nav-links li:last-child a:hover {
  background: var(--clr-primary-dark);
}

.menu-btn {
  display: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: var(--clr-primary);
  padding: 4px 8px;
  border-radius: var(--radius-sm);
  transition: background var(--dur-fast);
  user-select: none;
}

.menu-btn:hover { background: var(--crimson-50); }

/* Mobile nav */
@media (max-width: 768px) {
  .menu-btn { display: block; }

  .nav-links {
    display: none;
    flex-direction: column;
    position: absolute;
    top: 68px; left: 0; right: 0;
    background: var(--clr-surface);
    border-bottom: 1px solid var(--clr-border);
    padding: var(--sp-md);
    gap: 4px;
    box-shadow: var(--shadow-md);
  }

  .nav-links.open { display: flex; }
  .nav-links a { width: 100%; border-radius: var(--radius-sm); }
  .nav-links li:last-child a { text-align: center; }
}

/* ── Buttons ──────────────────────────────────────────────── */
.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 36px;
  background: linear-gradient(135deg, var(--crimson-600), var(--crimson-800));
  color: #fff;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: .95rem;
  letter-spacing: .04em;
  border: none;
  border-radius: var(--radius-full);
  cursor: pointer;
  box-shadow: 0 4px 20px rgba(139,30,63,.35);
  transition: transform var(--dur-fast) var(--ease-out),
              box-shadow var(--dur-fast);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(139,30,63,.45);
}

.btn-primary:active { transform: translateY(0); }

.btn-outline {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 13px 32px;
  background: transparent;
  color: var(--clr-primary);
  font-weight: 600;
  font-size: .95rem;
  letter-spacing: .04em;
  border: 1.5px solid var(--clr-primary);
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: background var(--dur-fast), color var(--dur-fast),
              transform var(--dur-fast) var(--ease-out);
}

.btn-outline:hover {
  background: var(--clr-primary);
  color: #fff;
  transform: translateY(-2px);
}

/* ── Footer ───────────────────────────────────────────────── */
footer {
  background: var(--ink-900);
  color: var(--ink-300);
  padding: var(--sp-xl) var(--sp-lg) var(--sp-lg);
}

.footer-content {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: var(--sp-lg);
  padding-bottom: var(--sp-lg);
  border-bottom: 1px solid rgba(255,255,255,.08);
}

.footer-content h3 {
  font-family: var(--font-display);
  font-size: 2rem;
  font-weight: 700;
  color: #fff;
  letter-spacing: .02em;
}

.footer-content p {
  font-size: .85rem;
  margin-top: 4px;
  opacity: .6;
}

.footer-links {
  max-width: 1200px;
  margin: var(--sp-md) auto 0;
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-md);
}

.footer-links a {
  font-size: .82rem;
  color: var(--ink-300);
  opacity: .7;
  transition: opacity var(--dur-fast), color var(--dur-fast);
}

.footer-links a:hover { opacity: 1; color: var(--gold-300); }

@media (max-width: 600px) {
  .footer-content { grid-template-columns: 1fr; }
  .footer-links { gap: var(--sp-sm); }
}

/* ── Install popup ────────────────────────────────────────── */
.install-popup {
  position: fixed;
  bottom: 24px; left: 50%;
  transform: translateX(-50%) translateY(120px);
  background: var(--ink-900);
  color: #fff;
  display: flex;
  align-items: center;
  gap: var(--sp-md);
  padding: 14px 24px;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-lg);
  font-size: .9rem;
  font-weight: 500;
  transition: transform var(--dur-med) var(--ease-out);
  z-index: 2000;
}

.install-popup.visible {
  transform: translateX(-50%) translateY(0);
}

.install-popup button {
  background: rgba(255,255,255,.15);
  border: 1px solid rgba(255,255,255,.2);
  color: #fff;
  padding: 6px 16px;
  border-radius: var(--radius-full);
  cursor: pointer;
  font-size: .85rem;
  transition: background var(--dur-fast);
}

.install-popup button:hover { background: rgba(255,255,255,.25); }

/* ── Utility ──────────────────────────────────────────────── */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--sp-lg);
}

.visually-hidden {
  position: absolute; width:1px; height:1px;
  overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap;
}
